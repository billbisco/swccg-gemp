#!/usr/bin/env bash
# Regenerates the three card blueprint database files from the Java card classes:
#   src/gemp-swccg-cards/src/main/resources/card_blueprint_database{,_light,_dark}.json
# These files are build outputs with one writer: the regen-blueprint-db GitHub workflow runs this
# script on master after each merge that touches card code, and commits the result.
# PRs and Players Committee syncs never include these files. Run it yourself only to get fresh files
# for a local tool, or to catch master up if the workflow failed.
#
# Usage: bin/regen-blueprint-db            (builds the modules it needs, then exports; no Docker)
#        bin/regen-blueprint-db --no-build (export only, from an already-built tree)
set -euo pipefail
cd "$(dirname "$0")/../src"
if [[ "${1:-}" != "--no-build" ]]; then
    mvn -q -B -DskipTests -Dcheckstyle.skip -pl gemp-swccg-server -am install
fi
mvn -q -B -Dcheckstyle.skip -pl gemp-swccg-server exec:java@export-blueprint-db
git -C .. status --short -- src/gemp-swccg-cards/src/main/resources/card_blueprint_database*.json || true
